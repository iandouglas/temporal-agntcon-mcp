# ---------------------------------------------------------------------------
# The four services, exposed as four zero-argument MCP tools.
# service_N_name becomes the tool name (sanitized: "Order Taco" -> order_taco).
# Scanning stops at the first gap, so keep the indexes contiguous.
#
# On Railway these are private-network URLs: http:// (not https - Wireguard
# already encrypts it and there is no internal TLS), and the private network is
# runtime-only, so nothing in a build step may reach them.
# ---------------------------------------------------------------------------
service_1_url=http://taco-service.railway.internal:8080/taco
service_1_name=Order Taco
service_1_description=Place an order for a taco and wait until the kitchen confirms it.

service_2_url=http://coffee-service.railway.internal:8080/coffee
service_2_name=Order Coffee
service_2_description=Place an order for a coffee and wait until the barista confirms it.

service_3_url=http://inventory-service.railway.internal:8080/inventory
service_3_name=Restock Inventory
service_3_description=Reorder stock from the supplier and wait for confirmation.

service_4_url=http://receipt-service.railway.internal:8080/receipt
service_4_name=Send Receipt
service_4_description=Send the customer their receipt and wait for delivery confirmation.

# ---------------------------------------------------------------------------
# Auth. Both are required; the server refuses to boot without them.
# Rotate both after the talk - the public URL will have been on a projector.
# ---------------------------------------------------------------------------
# Comma-separated label:token pairs. Labels appear in logs, so you can tell
# which agent placed an order.
mcp_agent_tokens=melissa-agent:replace-me-agent-token
# Grants the admin role, but ONLY on the internal listener. Presented to the
# public port it is downgraded to agent.
admin_token=replace-me-admin-token

# ---------------------------------------------------------------------------
# Temporal Cloud
# ---------------------------------------------------------------------------
temporal_address=your-namespace.abcde.tmprl.cloud:7233
temporal_namespace=your-namespace.abcde
temporal_api_key=replace-me
temporal_task_queue=durable-mcp
# temporal_tls defaults to true whenever temporal_api_key is set.

# ---------------------------------------------------------------------------
# Redis (Railway injects REDIS_URL when you add the Redis service)
# Availability flags live here so they survive an MCP server restart.
# Reads fail OPEN: a Redis blip must never be able to wedge the demo.
# ---------------------------------------------------------------------------
redis_url=${{Redis.REDIS_URL}}

# ---------------------------------------------------------------------------
# Ports. Railway sets PORT; give it the public domain via target ports.
# admin_port gets NO domain, so /admin/* has no route from the internet.
# ---------------------------------------------------------------------------
# port=8080
# admin_port=8081

# ---------------------------------------------------------------------------
# Timing. Defaults are tuned for the demo; override only deliberately.
# ---------------------------------------------------------------------------
# A short start_to_close is load-bearing: without it a *hanging* service
# produces one activity attempt that never fails, so no retry ever fires and
# the attempt counter freezes at 1.
# activity_start_to_close_seconds=3
# http_timeout_seconds=2.5
# retry_initial_interval_ms=250
# Bounded under Railway's 15-minute hard request cap.
# tool_call_max_wait_seconds=840
# dashboard_poll_seconds=0.5
# tools_list_ttl_ms=30000

# Local development only. Relaxes auth. Never set this on Railway.
# allow_insecure=1
